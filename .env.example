# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Model Inference Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Tavily Web Search API (Live Company Research & Interview Intelligence Dossier)
# Get your free key at https://tavily.com (1,000 monthly credits)
# Supports both Next.js and Vite env prefixes, with automatic 650ms fallback if omitted.
TAVILY_API_KEY=tvly-your-api-key-here
